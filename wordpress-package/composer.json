{
  "name": "keleva/woo-developer-package",
  "description": "Tooling de qualité pour le thème et l’extension Keleva Woo",
  "type": "project",
  "require-dev": {
    "php-stubs/woocommerce-stubs": "^11.0",
    "php-stubs/wordpress-stubs": "^6.9",
    "phpcompatibility/php-compatibility": "^9.0",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.11",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "find wordpress wordpress-dev -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
    "lint:phpcs": "phpcs --standard=phpcs.xml.dist",
    "lint:phpstan": "phpstan analyse --configuration=phpstan.neon.dist"
  }
}
